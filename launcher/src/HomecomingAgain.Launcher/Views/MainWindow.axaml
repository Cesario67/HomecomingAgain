<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HomecomingAgain.Launcher.ViewModels"
        x:Class="HomecomingAgain.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L[WindowTitle]}"
        Width="860" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="16">

    <!-- Dossier du jeu -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="{Binding L[GameFolder]}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding GameDirectory}" IsReadOnly="True" />
      <Button Grid.Column="2" Content="{Binding L[Change]}" Margin="8,0,0,0" Click="ChooseGameFolder" />
      <ComboBox Grid.Column="3" Margin="16,0,0,0" MinWidth="120" ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}" />
    </Grid>

    <!-- Barre du bas : message, valeurs par défaut, enregistrer, jouer -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{Binding L[ResetDefaults]}" Command="{Binding ResetSettingsCommand}" Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="{Binding L[Save]}" Command="{Binding SaveSettingsCommand}" Margin="8,0" />
      <Button Grid.Column="3" Content="{Binding L[Play]}" Command="{Binding PlayCommand}" Classes="accent"
              FontWeight="SemiBold" Padding="24,8" />
    </Grid>

    <TabControl IsEnabled="{Binding HasGame}">

      <!-- Graphismes -->
      <TabItem Header="{Binding L[TabGraphics]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Graphics}" x:DataType="vm:GraphicsViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecDisplay]}" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Text="{Binding L[Mode]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" />
              <TextBlock Grid.Row="1" Text="{Binding L[Resolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[DisplayHint]}" />
            <TextBlock Classes="warning" Text="{Binding L[FullscreenWarning]}" IsVisible="{Binding ShowFullscreenWarning}" />

            <TextBlock Classes="section" Text="{Binding L[SecImage]}" />
            <CheckBox Content="{Binding L[Smaa]}" IsChecked="{Binding Smaa}" />
            <TextBlock Classes="hint" Text="{Binding L[SmaaHint]}" />
            <CheckBox Content="{Binding L[Dlss]}" IsChecked="{Binding Dlss}" IsEnabled="{Binding DlssAvailable}" />
            <TextBlock Classes="hint" Text="{Binding L[DlssHint]}" />
            <TextBlock Classes="warning" Text="{Binding L[DlssLinux]}" IsVisible="{Binding DlssUnsupportedOnLinux}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[Anisotropy]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AnisotropyLevels}" SelectedItem="{Binding SelectedAnisotropy}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[AnisotropyHint]}" />
            <TextBlock Classes="section" Text="{Binding L[SecLighting]}" />
            <CheckBox Content="{Binding L[Ssao]}" IsChecked="{Binding Ssao}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[SsaoStrength]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{Binding Ssao}"
                        ItemsSource="{Binding SsaoStrengths}" SelectedItem="{Binding SelectedSsaoStrength}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[SsaoHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[ShadowResolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ShadowResolutions}" SelectedItem="{Binding SelectedShadowResolution}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[ShadowResolutionHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[FilmGrain]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FilmGrainLevels}" SelectedItem="{Binding SelectedFilmGrain}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[FilmGrainHint]}" />
            <CheckBox Content="{Binding L[FullScreenUiClip]}" IsChecked="{Binding FullScreenUiClip}" />
            <TextBlock Classes="hint" Text="{Binding L[FullScreenUiClipHint]}" />
            <CheckBox Content="{Binding L[ObjectViewPerspective]}" IsChecked="{Binding ObjectViewPerspective}" />
            <TextBlock Classes="hint" Text="{Binding L[ObjectViewPerspectiveHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecController]}" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="{Binding L[ButtonIcons]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ButtonIconSets}" SelectedItem="{Binding SelectedButtonIcons}" />
              <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ButtonIconPreview}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ButtonGlyph">
                    <Border Width="30" Height="30" CornerRadius="15" BorderThickness="2" Background="#1E1E1E"
                            BorderBrush="{Binding Color}">
                      <Panel>
                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasShape}" />
                        <Path Data="{Binding Shape}" Stroke="{Binding Color}" StrokeThickness="2" Width="16" Height="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasShape}" />
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[ButtonIconsHint]}" />
            <CheckBox Content="{Binding L[AnimatedIcons]}" IsChecked="{Binding AnimatedIcons}" />
            <TextBlock Classes="hint" Text="{Binding L[AnimatedIconsHint]}" />
            <CheckBox Content="{Binding L[MenuPad]}" IsChecked="{Binding MenuPad}" />
            <TextBlock Classes="hint" Text="{Binding L[MenuPadHint]}" />
            <CheckBox Content="{Binding L[PlayStationPad]}" IsChecked="{Binding PlayStationPad}" />
            <TextBlock Classes="hint" Text="{Binding L[PlayStationPadHint]}" />
            <CheckBox Content="{Binding L[CameraFix]}" IsChecked="{Binding CameraFix}" />
            <TextBlock Classes="hint" Text="{Binding L[CameraFixHint]}" />
            <CheckBox Content="{Binding L[CameraOrbit]}" IsChecked="{Binding CameraOrbit}" IsEnabled="{Binding CameraFix}" />
            <TextBlock Classes="hint" Text="{Binding L[CameraOrbitHint]}" />
            <CheckBox Content="{Binding L[OrbitGuardFollow]}" IsChecked="{Binding OrbitGuardFollow}" IsEnabled="{Binding CameraOrbit}" />
            <TextBlock Classes="hint" Text="{Binding L[OrbitGuardFollowHint]}" />
            <Grid ColumnDefinitions="220,*,50" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" IsEnabled="{Binding CameraFix}">
              <TextBlock Text="{Binding L[CameraHorizontalSpeed]}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding CameraHorizontalSpeed}" />
              <TextBlock Grid.Column="2" Text="{Binding CameraHorizontalSpeed, StringFormat={}{0:0.00}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="{Binding L[CameraVerticalSpeed]}" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding CameraVerticalSpeed}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CameraVerticalSpeed, StringFormat={}{0:0.00}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="{Binding L[CameraAimHorizontalSpeed]}" VerticalAlignment="Center" />
              <Slider Grid.Row="2" Grid.Column="1" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding CameraAimHorizontalSpeed}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CameraAimHorizontalSpeed, StringFormat={}{0:0.00}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Row="3" Text="{Binding L[CameraAimVerticalSpeed]}" VerticalAlignment="Center" />
              <Slider Grid.Row="3" Grid.Column="1" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding CameraAimVerticalSpeed}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CameraAimVerticalSpeed, StringFormat={}{0:0.00}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[CameraSpeedsHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecGameQuality]}" />
            <CheckBox Content="{Binding L[HighQualityShaders]}" IsChecked="{Binding HighQualityShaders}" />
            <CheckBox Content="{Binding L[FullResolutionTextures]}" IsChecked="{Binding FullResolutionTextures}" />
            <TextBlock Classes="hint" Text="{Binding L[GameQualityHint]}" />
            <TextBlock Classes="hint" Text="{Binding L[SmaaCredit]}" />
            <TextBlock Classes="hint" Text="{Binding L[DlssCredit]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Performances et stabilité -->
      <TabItem Header="{Binding L[TabPerformance]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Performance}" x:DataType="vm:PerformanceViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecFrameRate]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[TargetFps]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[TargetFpsHint]}" />
            <TextBlock Classes="warning" Text="{Binding L[HighFpsWarning]}" IsVisible="{Binding ShowHighFrameRateWarning}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[FrameLimit]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FrameLimits}" SelectedItem="{Binding SelectedFrameLimit}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[FrameLimitHint]}" />
            <CheckBox Content="{Binding L[PreciseTimer]}" IsChecked="{Binding PreciseTimer}" />
            <TextBlock Classes="hint" Text="{Binding L[PreciseTimerHint]}" />
            <CheckBox Content="{Binding L[SkipLogos]}" IsChecked="{Binding SkipLogos}" />
            <TextBlock Classes="hint" Text="{Binding L[SkipLogosHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecAudio]}" />
            <CheckBox Content="{Binding L[AudioChannelFix]}" IsChecked="{Binding AudioChannelFix}" />
            <TextBlock Classes="hint" Text="{Binding L[AudioChannelFixHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[AudioChannels]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AudioChannelChoices}" SelectedItem="{Binding SelectedAudioChannels}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[AudioChannelsHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecCheats]}" />
            <CheckBox Content="{Binding L[God]}" IsChecked="{Binding God}" />
            <CheckBox Content="{Binding L[UnlimitedAmmo]}" IsChecked="{Binding UnlimitedAmmo}" />
            <TextBlock Classes="hint" Text="{Binding L[CheatsHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecCompatibility]}" />
            <CheckBox Content="{Binding L[WindowThreadLock]}" IsChecked="{Binding WindowThreadLock}" />
            <CheckBox Content="{Binding L[D3DMultithreaded]}" IsChecked="{Binding D3DMultithreaded}" />
            <TextBlock Classes="hint" Text="{Binding L[CompatibilityHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecDiagnostics]}" />
            <CheckBox Content="{Binding L[CrashDumps]}" IsChecked="{Binding CrashDumps}" />
            <CheckBox Content="{Binding L[FullDumps]}" IsChecked="{Binding FullMemoryDumps}" />
            <CheckBox Content="{Binding L[HangDetection]}" IsChecked="{Binding HangDetection}" />
            <CheckBox Content="{Binding L[FrameStats]}" IsChecked="{Binding FrameStats}" />
            <TextBlock Classes="hint" Text="{Binding L[DiagnosticsHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Avancé -->
      <TabItem Header="{Binding L[TabAdvanced]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Advanced}" x:DataType="vm:AdvancedViewModel">
            <TextBlock Classes="hint" Text="{Binding L[AdvancedHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecAdvancedSsao]}" />
            <Grid ColumnDefinitions="220,160" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Text="{Binding L[SsaoRadius]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding SsaoRadius}" Minimum="0.05" Maximum="100" Increment="0.1"
                             FormatString="0.0#" />
              <TextBlock Grid.Row="1" Text="{Binding L[SsaoFadeStart]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SsaoFadeStart}" Minimum="0" Maximum="100000"
                             Increment="10" FormatString="0" />
              <TextBlock Grid.Row="2" Text="{Binding L[SsaoFadeEnd]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SsaoFadeEnd}" Minimum="1" Maximum="100000"
                             Increment="10" FormatString="0" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[SsaoAdvancedHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecAdvancedAudioMovies]}" />
            <Grid ColumnDefinitions="220,160" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Text="{Binding L[ChannelOrder]}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding ChannelOrder}" />
              <TextBlock Grid.Row="1" Text="{Binding L[SkipKey]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SkipKey}" Minimum="0" Maximum="254"
                             Increment="1" FormatString="0" />
            </Grid>
            <TextBlock Classes="warning" Text="{Binding L[ChannelOrderInvalid]}" IsVisible="{Binding ChannelOrderInvalid}" />
            <TextBlock Classes="hint" Text="{Binding L[AudioMoviesAdvancedHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecAdvancedDiagnostics]}" />
            <Grid ColumnDefinitions="220,160" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Text="{Binding L[ReportInterval]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding ReportIntervalSeconds}" Minimum="1" Maximum="3600"
                             Increment="1" FormatString="0" />
              <TextBlock Grid.Row="1" Text="{Binding L[DumpKeepCount]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DumpKeepCount}" Minimum="1" Maximum="100"
                             Increment="1" FormatString="0" />
              <TextBlock Grid.Row="2" Text="{Binding L[LogKeepCount]}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding LogKeepCount}" Minimum="1" Maximum="500"
                             Increment="1" FormatString="0" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[DiagnosticsAdvancedHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecExperimental]}" />
            <CheckBox Content="{Binding L[D3D9On12]}" IsChecked="{Binding D3D9On12}" />
            <TextBlock Classes="hint" Text="{Binding L[D3D9On12Hint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Installation -->
      <TabItem Header="{Binding L[TabInstall]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Status}" x:DataType="vm:StatusViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecStatus]}" />
            <TextBlock Text="{Binding GameVersion}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ModState}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MemoryState}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GameSettingsState}" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="{Binding L[SecInstallation]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
              <Button Content="{Binding L[Uninstall]}" Command="{Binding UninstallCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding L[InstallHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecSteam]}" />
            <TextBlock Classes="hint" Text="{Binding L[SteamHint]}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding SteamLaunchOption}" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{Binding L[Copy]}" Margin="8,0,0,0" Click="CopySteamLaunchOption" />
            </Grid>

            <TextBlock Classes="section" Text="{Binding L[SecDiagnosticTools]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[CreateBugReport]}" Command="{Binding CreateBugReportCommand}" />
              <Button Content="{Binding L[OpenLatestLog]}" Command="{Binding OpenLatestLogCommand}" />
              <Button Content="{Binding L[OpenModFolder]}" Command="{Binding OpenModFolderCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding L[CrashReportHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
