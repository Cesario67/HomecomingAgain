<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HomecomingAgain.Launcher.ViewModels"
        x:Class="HomecomingAgain.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L[WindowTitle]}"
        Width="860" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="16">

    <!-- Dossier du jeu -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="{Binding L[GameFolder]}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding GameDirectory}" IsReadOnly="True" />
      <Button Grid.Column="2" Content="{Binding L[Change]}" Margin="8,0,0,0" Click="ChooseGameFolder" />
      <ComboBox Grid.Column="3" Margin="16,0,0,0" MinWidth="120" ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}" />
    </Grid>

    <!-- Barre du bas : message, valeurs par défaut, enregistrer, jouer -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{Binding L[ResetDefaults]}" Command="{Binding ResetSettingsCommand}" Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="{Binding L[Save]}" Command="{Binding SaveSettingsCommand}" Margin="8,0" />
      <Button Grid.Column="3" Content="{Binding L[Play]}" Command="{Binding PlayCommand}" Classes="accent"
              FontWeight="SemiBold" Padding="24,8" />
    </Grid>

    <TabControl IsEnabled="{Binding HasGame}">

      <!-- Graphismes -->
      <TabItem Header="{Binding L[TabGraphics]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Graphics}" x:DataType="vm:GraphicsViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecDisplay]}" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Text="{Binding L[Mode]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" />
              <TextBlock Grid.Row="1" Text="{Binding L[Resolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[DisplayHint]}" />
            <TextBlock Classes="warning" Text="{Binding L[FullscreenWarning]}" IsVisible="{Binding ShowFullscreenWarning}" />

            <TextBlock Classes="section" Text="{Binding L[SecImage]}" />
            <CheckBox Content="{Binding L[Smaa]}" IsChecked="{Binding Smaa}" />
            <TextBlock Classes="hint" Text="{Binding L[SmaaHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[Anisotropy]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AnisotropyLevels}" SelectedItem="{Binding SelectedAnisotropy}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[AnisotropyHint]}" />
            <TextBlock Classes="section" Text="{Binding L[SecLighting]}" />
            <CheckBox Content="{Binding L[Ssao]}" IsChecked="{Binding Ssao}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[SsaoStrength]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{Binding Ssao}"
                        ItemsSource="{Binding SsaoStrengths}" SelectedItem="{Binding SelectedSsaoStrength}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[SsaoHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[ShadowResolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ShadowResolutions}" SelectedItem="{Binding SelectedShadowResolution}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[ShadowResolutionHint]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[FilmGrain]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FilmGrainLevels}" SelectedItem="{Binding SelectedFilmGrain}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[FilmGrainHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecGameQuality]}" />
            <CheckBox Content="{Binding L[HighQualityShaders]}" IsChecked="{Binding HighQualityShaders}" />
            <CheckBox Content="{Binding L[FullResolutionTextures]}" IsChecked="{Binding FullResolutionTextures}" />
            <TextBlock Classes="hint" Text="{Binding L[GameQualityHint]}" />
            <TextBlock Classes="hint" Text="{Binding L[SmaaCredit]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Performances et stabilité -->
      <TabItem Header="{Binding L[TabPerformance]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Performance}" x:DataType="vm:PerformanceViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecFrameRate]}" />
            <Grid ColumnDefinitions="220,*">
              <TextBlock Text="{Binding L[TargetFps]}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding L[TargetFpsHint]}" />
            <TextBlock Classes="warning" Text="{Binding L[HighFpsWarning]}" IsVisible="{Binding ShowHighFrameRateWarning}" />
            <CheckBox Content="{Binding L[PreciseTimer]}" IsChecked="{Binding PreciseTimer}" />
            <TextBlock Classes="hint" Text="{Binding L[PreciseTimerHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecCompatibility]}" />
            <CheckBox Content="{Binding L[WindowThreadLock]}" IsChecked="{Binding WindowThreadLock}" />
            <CheckBox Content="{Binding L[D3DMultithreaded]}" IsChecked="{Binding D3DMultithreaded}" />
            <TextBlock Classes="hint" Text="{Binding L[CompatibilityHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecDiagnostics]}" />
            <CheckBox Content="{Binding L[CrashDumps]}" IsChecked="{Binding CrashDumps}" />
            <CheckBox Content="{Binding L[FullDumps]}" IsChecked="{Binding FullMemoryDumps}" />
            <CheckBox Content="{Binding L[HangDetection]}" IsChecked="{Binding HangDetection}" />
            <CheckBox Content="{Binding L[FrameStats]}" IsChecked="{Binding FrameStats}" />
            <TextBlock Classes="hint" Text="{Binding L[DiagnosticsHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Installation -->
      <TabItem Header="{Binding L[TabInstall]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Status}" x:DataType="vm:StatusViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecStatus]}" />
            <TextBlock Text="{Binding GameVersion}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ModState}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MemoryState}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GameSettingsState}" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="{Binding L[SecInstallation]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
              <Button Content="{Binding L[Uninstall]}" Command="{Binding UninstallCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding L[InstallHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecSteam]}" />
            <TextBlock Classes="hint" Text="{Binding L[SteamHint]}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding SteamLaunchOption}" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{Binding L[Copy]}" Margin="8,0,0,0" Click="CopySteamLaunchOption" />
            </Grid>

            <TextBlock Classes="section" Text="{Binding L[SecDiagnosticTools]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[OpenLatestLog]}" Command="{Binding OpenLatestLogCommand}" />
              <Button Content="{Binding L[OpenModFolder]}" Command="{Binding OpenModFolderCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding L[CrashReportHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
