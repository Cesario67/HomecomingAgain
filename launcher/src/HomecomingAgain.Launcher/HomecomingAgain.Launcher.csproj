<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Requis par LibraryImport (AttachConsole, Program.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>HomecomingAgain</AssemblyName>
    <RootNamespace>HomecomingAgain.Launcher</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Homecoming Again</Product>
    <Description>Homecoming Again : installation, réglages et lancement de Silent Hill: Homecoming</Description>
    <Copyright>Copyright (C) 2026 Cesar Schaal. Licence GPL-3.0-or-later.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Publication : un seul .exe autonome (aucun runtime .NET à installer chez le joueur). L'option
         « autonome » est passée à la publication (tools/build.ps1 : -r win-x64 - -self-contained) : déclarée
         ici, elle empêcherait le projet de test de référencer celui-ci. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Taille : élagage du code .NET inutilisé (liaisons compilées, pas de réflexion) et compression. -->
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Fichiers du mod intégrés au .exe : les joueurs ne téléchargent que HomecomingAgain.exe (voir
       Core/EmbeddedPackage). Ils viennent de la compilation C++ (cmake, tools/build.ps1), qui doit donc passer
       avant ; sans DLL compilée, le launcher est construit sans eux (développement, tests). -->
  <PropertyGroup>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build\x86-release\package</PayloadDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(PayloadDir)\version.dll')">
    <EmbeddedResource Include="$(PayloadDir)\version.dll" LogicalName="payload/version.dll" />
    <EmbeddedResource Include="$(PayloadDir)\HomecomingAgain.ini" LogicalName="payload/HomecomingAgain.ini" />
    <EmbeddedResource Include="$(PayloadDir)\LICENSE.txt" LogicalName="payload/LICENSE.txt" />
    <EmbeddedResource Include="$(PayloadDir)\LICENSE-SMAA.txt" LogicalName="payload/LICENSE-SMAA.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomecomingAgain.Launcher.Tests" />
  </ItemGroup>

</Project>
